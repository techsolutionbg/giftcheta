{
  "name": "giftcheta/storefront",
  "description": "A lightweight, independent Giftcheta commerce platform foundation.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "dompdf/dompdf": "^3.1",
    "symfony/mailer": "^7.4"
  },
  "require-dev": {"phpunit/phpunit": "^11.0"},
  "autoload": {"psr-4": {"Giftcheta\\": "app/"}},
  "autoload-dev": {"psr-4": {"Giftcheta\\Tests\\": "tests/"}},
  "scripts": {"test": "phpunit", "migrate": "php bin/migrate.php", "lint": "find app config public bin tests -name '*.php' -print0 | xargs -0 -n1 php -l"},
  "config": {"sort-packages": true, "platform": {"php": "8.3.0"}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
